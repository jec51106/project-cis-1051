import matplotlib.pyplot as plt

car_price = float(input("Enter the car price: $"))
down_payment = float(input("Enter your down payment: $"))

loan_amount = car_price - down_payment

if loan_amount <= 0:
    print("No loan needed.")
    quit()

credit_score = int(input("Enter your credit score: "))
years = int(input("Enter loan term in years: "))

#loan shark rates
if credit_score >= 750:
    annual_rate = 0.17   
elif credit_score >= 700:
    annual_rate = 0.21   
elif credit_score >= 650:
    annual_rate = 0.28   
elif credit_score >= 600:
    annual_rate = 0.39  
else:
    annual_rate = 0.56   # loan shark special

monthly_rate = annual_rate / 12
months = years * 12

#monthly payment
monthly_payment = (
    loan_amount *
    (monthly_rate * (1 + monthly_rate)**months) /
    ((1 + monthly_rate)**months - 1)
)

total_paid = monthly_payment * months
total_interest = total_paid - loan_amount

#payment details
print("\n--- Loan Summary ---")
print(f"Loan Amount: ${loan_amount:,.2f}")
print(f"Interest Rate: {annual_rate*100:.1f}%")
print(f"Monthly Payment: ${monthly_payment:,.2f}")
print(f"Total Paid: ${total_paid:,.2f}")
print(f"Interest Paid: ${total_interest:,.2f}")

#loan increase
balance = loan_amount
balances = [balance]
total_paid_over_time = [0]
months_list = [0]

paid_so_far = 0

for month in range(1, months+1):
    interest = balance * monthly_rate
    principal_paid = monthly_payment - interest

    balance -= principal_paid
    paid_so_far += monthly_payment

    if balance < 0:
        balance = 0

    balances.append(balance)
    total_paid_over_time.append(paid_so_far)
    months_list.append(month)

#graphs
plt.figure(figsize=(10,6))


plt.subplot(2,1,1)
plt.plot(months_list, balances)
plt.title("Remaining Loan Balance Over Time")
plt.xlabel("Months")
plt.ylabel("Balance ($)")
plt.grid(True)


plt.subplot(2,1,2)
plt.plot(months_list, total_paid_over_time)
plt.title("Total Money Paid Over Time")
plt.xlabel("Months")
plt.ylabel("Paid ($)")
plt.grid(True)

plt.tight_layout()
plt.show()

if total_interest>=(0.25*loan_amount):
    print("YOU GOT SCREWED!")
else:
    print("Honestly, normal")
